# CutFlow Environment Variables
# Copy to .env and fill in values

SECRET_KEY=meoemeoemoewmeoemeoemoewmeoemeoemoewmeoemeoemoewah
DEBUG=True
ALLOWED_HOSTS=*
USE_SQLITE=True
DB_FALLBACK_TO_SQLITE=True

# Database
DB_NAME=cutflow_db
DB_USER=cutflow_user
DB_PASSWORD=your_password
DB_HOST=localhost
DB_PORT=3306

# Email (optional for dev – uses console backend when DEBUG=True)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=CutFlow <noreply@cutflow.com>

# Company
COMPANY_NAME=CutFlow Fenestration

# Security flags; keep false in local development without HTTPS
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=INFO
